{
  "name": "eee-advisor-mobile",
  "version": "1.0.0",
  "description": "PolyU EEE Programme Advisor – Capacitor mobile wrapper",
  "private": true,
  "scripts": {
    "build:web": "cd ../web && npm run build",
    "sync": "npx cap sync",
    "sync:android": "npx cap sync android",
    "sync:ios": "npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "deploy:android": "npm run build:web && npx cap sync android",
    "deploy:ios": "npm run build:web && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.9.3"
  }
}
